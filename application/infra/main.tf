terraform {
  backend "s3" {
    bucket       = "platform-lab-tfstate-007"
    key          = "platform-lab/application-pipeline.tfstate"
    region       = "us-east-1"
    use_lockfile = true
    encrypt      = true
  }

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
  }
}

provider "aws" {
  region = "us-east-1"
}
